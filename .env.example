# Copy this file to .env and fill in LLM_API_KEY. Never commit .env.
#
# The agent talks to any OpenAI-compatible Chat Completions API that supports
# tool calling. The default is the Google Gemini API (free tier).
# Get a free key at https://aistudio.google.com/apikey

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Optional: sampling temperature. Leave empty to use the provider's default.
LLM_TEMPERATURE=

# Local model with Ollama instead (no key needed, any non-empty value works):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# Optional: the shop's "current" date and time. The default comes from the
# data README: 2026-06-10 09:00 Europe/Warsaw.
# CITYWHEELS_NOW=2026-06-10T09:00:00+02:00
